# =============================================================================
# CIRCUITRA ENVIRONMENT CONFIGURATION (PLACEHOLDERS ONLY)
# Never commit real secrets, private keys, or credentials to version control.
# =============================================================================

# Frontend Public Variables (Safe for client browser)
# Replace with your project URL and anonymous public key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Backend Privileged Secrets (SUPABASE EDGE FUNCTIONS / CLI ONLY)
# NEVER expose VITE_ prefix to these backend-only secrets!
# Set these using `supabase secrets set` or the Supabase Edge Function Secrets dashboard.

# Official Google Gemini API Key from Google AI Studio (Backend Edge Function Secret)
GEMINI_API_KEY=your-gemini-api-key-here

# Supported Configurable Gemini Model (e.g. gemini-3.5-flash-lite)
# gemini-3.5-flash-lite is fast, reliable, supports structured JSON schema outputs, and provides high rate allowances.
GEMINI_MODEL=gemini-3.5-flash-lite

# Privileged Supabase Service Role Key (Used strictly for server-side administrative hooks / migrations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
